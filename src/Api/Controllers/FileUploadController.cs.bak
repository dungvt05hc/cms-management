using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers;

/// <summary>
/// Controller for handling file uploads.
/// </summary>
[ApiController]
[Route("admin/uploads")]
[Authorize(Policy = "AdminOnly")]
public class FileUploadController : ControllerBase
{
    private readonly IWebHostEnvironment environment;
    private readonly ILogger<FileUploadController> logger;
    private readonly string[] allowedExtensions = { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
    private readonly long maxFileSize = 5 * 1024 * 1024; // 5MB

    /// <summary>
    /// Initializes a new instance of the <see cref="FileUploadController"/> class.
    /// </summary>
    /// <param name="environment">The web host environment.</param>
    /// <param name="logger">The logger.</param>
    public FileUploadController(IWebHostEnvironment environment, ILogger<FileUploadController> logger)
    {
        this.environment = environment;
        this.logger = logger;
    }

    /// <summary>
    /// Upload a single image file.
    /// </summary>
    /// <param name="file">The image file to upload.</param>
    /// <returns>The URL of the uploaded image.</returns>
    [HttpPost("image")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [RequestSizeLimit(5 * 1024 * 1024)]
    public async Task<IActionResult> UploadImage(IFormFile file)
    {
        if (file == null || file.Length == 0)
        {
            return this.BadRequest(new { message = "No file provided" });
        }

        if (file.Length > this.maxFileSize)
        {
            return this.BadRequest(new { message = "File size exceeds 5MB limit" });
        }

        var extension = Path.GetExtension(file.FileName).ToLowerInvariant();
        if (!this.allowedExtensions.Contains(extension))
        {
            return this.BadRequest(new { message = $"Invalid file type. Allowed types: {string.Join(", ", this.allowedExtensions)}" });
        }

        try
        {
            var uploadsFolder = Path.Combine(this.environment.ContentRootPath, "wwwroot", "uploads", "products");
            Directory.CreateDirectory(uploadsFolder);

            var uniqueFileName = $"{Guid.NewGuid()}{extension}";
            var filePath = Path.Combine(uploadsFolder, uniqueFileName);

            using (var stream = new FileStream(filePath, FileMode.Create))
            {
                await file.CopyToAsync(stream);
            }

            var baseUrl = $"{this.Request.Scheme}://{this.Request.Host}";
            var imageUrl = $"{baseUrl}/uploads/products/{uniqueFileName}";

            this.logger.LogInformation("Image uploaded: {FileName} -> {Url}", file.FileName, imageUrl);

            return this.Ok(new { url = imageUrl, fileName = uniqueFileName });
        }
        catch (Exception ex)
        {
            this.logger.LogError(ex, "Failed to upload image: {FileName}", file.FileName);
            return this.StatusCode(500, new { message = "Failed to upload image" });
        }
    }

    /// <summary>
    /// Upload multiple image files.
    /// </summary>
    /// <param name="files">The image files to upload.</param>
    /// <returns>The URLs of the uploaded images.</returns>
    [HttpPost("images")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [RequestSizeLimit(25 * 1024 * 1024)]
    public async Task<IActionResult> UploadImages(List<IFormFile> files)
    {
        if (files == null || files.Count == 0)
        {
            return this.BadRequest(new { message = "No files provided" });
        }

        if (files.Count > 10)
        {
            return this.BadRequest(new { message = "Maximum 10 files allowed per upload" });
        }

        var results = new List<object>();
        var errors = new List<string>();

        foreach (var file in files)
        {
            if (file.Length > this.maxFileSize)
            {
                errors.Add($"{file.FileName}: File size exceeds 5MB limit");
                continue;
            }

            var extension = Path.GetExtension(file.FileName).ToLowerInvariant();
            if (!this.allowedExtensions.Contains(extension))
            {
                errors.Add($"{file.FileName}: Invalid file type");
                continue;
            }

            try
            {
                var uploadsFolder = Path.Combine(this.environment.ContentRootPath, "wwwroot", "uploads", "products");
                Directory.CreateDirectory(uploadsFolder);

                var uniqueFileName = $"{Guid.NewGuid()}{extension}";
                var filePath = Path.Combine(uploadsFolder, uniqueFileName);

                using (var stream = new FileStream(filePath, FileMode.Create))
                {
                    await file.CopyToAsync(stream);
                }

                var baseUrl = $"{this.Request.Scheme}://{this.Request.Host}";
                var imageUrl = $"{baseUrl}/uploads/products/{uniqueFileName}";

                results.Add(new { url = imageUrl, fileName = uniqueFileName, originalName = file.FileName });
            }
            catch (Exception ex)
            {
                this.logger.LogError(ex, "Failed to upload image: {FileName}", file.FileName);
                errors.Add($"{file.FileName}: Upload failed");
            }
        }

        return this.Ok(new { uploaded = results, errors });
    }

    /// <summary>
    /// Delete an uploaded image.
    /// </summary>
    /// <param name="fileName">The file name to delete.</param>
    /// <returns>Success status.</returns>
    [HttpDelete("{fileName}")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public IActionResult DeleteImage(string fileName)
    {
        var filePath = Path.Combine(this.environment.ContentRootPath, "wwwroot", "uploads", "products", fileName);

        if (!System.IO.File.Exists(filePath))
        {
            return this.NotFound(new { message = "File not found" });
        }

        try
        {
            System.IO.File.Delete(filePath);
            this.logger.LogInformation("Image deleted: {FileName}", fileName);
            return this.Ok(new { message = "File deleted successfully" });
        }
        catch (Exception ex)
        {
            this.logger.LogError(ex, "Failed to delete image: {FileName}", fileName);
            return this.StatusCode(500, new { message = "Failed to delete image" });
        }
    }
}
